            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bob Tech\",\n  \"email\": \"bob.tech@example.com\",\n  \"password\": \"password123\",\n  \"phone\": \"+1-555-0188\",\n  \"specialization\": \"Air Conditioner (AC)\",\n  \"role\": \"technician\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          },
          "response": []
        },
        {
