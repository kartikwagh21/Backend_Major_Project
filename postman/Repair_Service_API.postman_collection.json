    {
      "name": "2. Technicians",
      "item": [
        {
          "name": "List Technicians (Customer Access)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.length > 0) {",
                  "    pm.collectionVariables.set('technicianId', jsonData.data[0]._id);",
                  "    console.log('Technician ID saved:', jsonData.data[0]._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/technicians",
              "host": ["{{baseUrl}}"],
              "path": ["technicians"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Repair Requests (Core)",
      "item": [
        {
          "name": "Create Repair Request (Customer with Photo)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data._id) {",
                  "    pm.collectionVariables.set('requestId', jsonData.data._id);",
                  "    console.log('Created Request ID saved:', jsonData.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "technician",
                  "value": "{{technicianId}}",
                  "type": "text"
                },
                {
                  "key": "applianceType",
                  "value": "Air Conditioner (AC)",
                  "type": "text"
                },
                {
                  "key": "brand",
                  "value": "Daikin Inverter",
                  "type": "text"
                },
                {
                  "key": "issueDescription",
                  "value": "AC outdoor unit is making abnormal noise and indoor unit error code E4 is flashing.",
                  "type": "text"
                },
                {
                  "key": "photo",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/requests",
              "host": ["{{baseUrl}}"],
              "path": ["requests"]
            }
          },
          "response": []
        },
        {
          "name": "Get Customer's Own Requests (Customer Only)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/requests/my",
              "host": ["{{baseUrl}}"],
              "path": ["requests", "my"]
            }
          },
          "response": []
        },
        {
          "name": "Get Assigned Requests (Technician Only)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{technicianToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/requests/assigned",
              "host": ["{{baseUrl}}"],
              "path": ["requests", "assigned"]
            }
          },
          "response": []
        },
        {
          "name": "Get Request Details by ID (Authorized Customer / Tech)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/requests/{{requestId}}",
              "host": ["{{baseUrl}}"],
              "path": ["requests", "{{requestId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Update Status to 'In Progress' (Assigned Technician)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{technicianToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"In Progress\",\n  \"note\": \"Technician arrived at site, commenced diagnostic and component testing.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/requests/{{requestId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["requests", "{{requestId}}", "status"]
            }
          },
          "response": []
        },
        {
          "name": "Update Status to 'Completed' (Assigned Technician)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{technicianToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Completed\",\n  \"note\": \"Capacitor replaced and refrigerant pressure tuned. Appliance cooling optimally.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/requests/{{requestId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["requests", "{{requestId}}", "status"]
            }
          },
          "response": []
        }
      ]
    },
    {
