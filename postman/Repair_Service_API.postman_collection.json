{
  "info": {
    "_postman_id": "9b12a874-4821-4f76-bc34-9d18e8749132",
    "name": "Repair Service Management System API (Case Study #132)",
    "description": "Complete REST API collection for Case Study #132 - Repair Service Management System.\nFeatures:\n- Customer & Technician Registration/Login (JWT)\n- Image upload with Multer\n- Role-based & Ownership-based authorization\n- Strict status workflow progression: Assigned -> In Progress -> Completed\n- Centralized error handling & validation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001/api",
      "type": "string"
    },
    {
      "key": "customerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "technicianToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "otherTechnicianToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "technicianId",
      "value": "",
      "type": "string"
    },
    {
      "key": "requestId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Customer\",\n  \"email\": \"alice.customer@example.com\",\n  \"password\": \"password123\",\n  \"phone\": \"+1-555-0144\",\n  \"address\": \"742 Evergreen Terrace, Springfield\",\n  \"role\": \"customer\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          },
          "response": []
        },
        {
          "name": "Register Technician",
          "request": {
            "method": "POST",
            "header": [
