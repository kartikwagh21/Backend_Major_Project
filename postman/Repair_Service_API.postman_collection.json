            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Charlie Tech\",\n  \"email\": \"charlie.tech@example.com\",\n  \"password\": \"password123\",\n  \"phone\": \"+1-555-0199\",\n  \"specialization\": \"Refrigerator\",\n  \"role\": \"technician\"\n}"
            },
            "url": {
